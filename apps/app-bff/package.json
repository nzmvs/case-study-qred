{
  "name": "@qred/app-bff",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=source --test 'src/**/*.test.ts'",
    "gen:api": "for c in app-bff identity-api card-api billing-api; do openapi-typescript ../../contracts/$c.yaml -o src/generated/$c.ts; done"
  },
  "dependencies": {
    "@qred/service-kit": "workspace:*",
    "fastify": "^5.12.5",
    "openapi-fetch": "^0.17.0",
    "unleash-client": "^6.12.2"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
