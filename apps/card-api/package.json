{
  "name": "@qred/card-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && pnpm db:seed && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:codegen": "kysely-codegen --dialect postgres --camel-case --type-mapping '{\"int8\":\"number\"}' --exclude-pattern 'kysely_*' --out-file src/db/types.ts",
    "gen:api": "openapi-typescript ../../contracts/card-api.yaml -o src/generated/card-api.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "openapi-typescript": "^7.13.0"
  }
}
