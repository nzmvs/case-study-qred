{
  "name": "@qred/card-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && pnpm db:seed && tsx watch --conditions=source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=source --test 'src/**/*.test.ts'",
    "db:migrate": "kysely migrate latest",
    "db:seed": "kysely seed run",
    "db:codegen": "kysely-codegen --dialect postgres --camel-case --type-mapping '{\"int8\":\"number\"}' --exclude-pattern 'kysely_*' --out-file src/db/types.ts",
    "gen:api": "openapi-typescript ../../contracts/card-api.yaml -o src/generated/card-api.ts"
  },
  "dependencies": {
    "@qred/service-kit": "workspace:*",
    "canonicalize": "^5.1.0",
    "env-schema": "^8.0.0",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.0"
  }
}
