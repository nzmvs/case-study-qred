{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {},
    "test": {},
    "gen:api": {
      "inputs": [
        "$TURBO_ROOT$/contracts/**"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}
